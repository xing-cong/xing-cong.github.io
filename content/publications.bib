@inproceedings{cong2026rtlynx,
  selected={true},
  first_author = {true},
  status = {accepted},
  published_date = {2026-05},
  title = {RT-Lynx: Putting the GEMM Sparsity In a Right Way for Diffusion Models},
  author = {Xing Cong},
  year = {2026},
  booktitle = {International Conference on Machine Learning (ICML)},
  url = {https://arxiv.org/abs/2605.26632},
  abstract = {RT-Lynx is a semi-structured activation sparsity framework for diffusion transformers. The work systematically studies why activation-side 2:4 N:M sparsity is better suited than weight-side sparsity for DiT inference, and introduces norm compensation and lightweight LoRA-based error recovery to preserve generation quality. It further develops an online fused sparse inference pipeline that integrates activation selection, format compression, and sparse GEMM into the CUDA execution path, enabling Sparse Tensor Core acceleration with reduced dynamic sparsity overhead.},
  description = {First-author work on a semi-structured activation sparsity framework for DiT models. RT-Lynx studies why activation-side 2:4 N:M sparsity is better suited than weight-side sparsity, and combines norm compensation, lightweight LoRA recovery, and an online fused sparse inference pipeline.},
  keywords = {Diffusion Models, Sparse GEMM, GPU Acceleration, AI Infrastructure}
}

@inproceedings{cong2025cbspmv,
  selected={true},
  first_author = {true},
  status = {published},
  published_date = {2025},
  title = {CB-SpMV: A Data Aggregating and Balance Algorithm for Cache-Friendly Block-Based SpMV on GPUs},
  author = {Xing Cong},
  year = {2025},
  booktitle = {International Conference on Supercomputing (ICS)},
  url = {https://arxiv.org/abs/2605.18515},
  abstract = {CB-SpMV is a cache-friendly block-based sparse matrix-vector multiplication framework for GPUs. It addresses irregular memory access, thread idling, and load imbalance through intra-block data aggregation, virtual pointers, column aggregation, and adaptive sub-block format selection. Large-scale evaluations on thousands of matrices show performance advantages over cuSPARSE, TileSpMV, and DASP on NVIDIA A100 and RTX 4090 GPUs, while improving cache locality.},
  description = {First-author work on a cache-friendly block sparse framework for GPU SpMV. CB-SpMV improves locality and hardware utilization through intra-block data aggregation, virtual pointers, column aggregation, and adaptive sub-block format selection.},
  keywords = {SpMV, Sparse Matrix, GPU, Cache Locality}
}

