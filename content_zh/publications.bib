@article{cong2026cbsparse,
  selected = {true},
  first_author = {true},
  status = {accepted},
  published_date = {2026-10},
  title = {CB-Sparse: A Cache-Friendly Data Aggregating Algorithm for Block-Based Sparse Matrix Multiplication on GPUs},
  author = {Cong, Xing and Sun, FuKai and Liu, Yiding and Xie, Chenhao and Liu, Yi and Qian, Depei},
  year = {2026},
  journal = {ACM Transactions on Architecture and Code Optimization (TACO)},
  month = {oct},
  publisher = {Association for Computing Machinery},
  doi = {10.1145/3848124},
  url = {https://doi.org/10.1145/3848124},
  code = {https://github.com/xing-cong/CB-Sparse},
  note = {Accepted in September 2026. Just Accepted version available online October 1, 2026; final volume, issue, and pages have not yet been assigned.},
  abstract = {CB-Sparse 是面向 GPU 的缓存友好稀疏矩阵乘法框架，统一支持 SpMV、SpMM 和 SpGEMM。该框架利用二维分块结构与虚拟指针聚合块内数据，并为不同乘法范式设计列聚合、自适应格式选择、负载均衡、累加写回及符号阶段优化。在 NVIDIA A100 和 RTX 4090 上，针对代表性基线，SpMV、SpMM 和 SpGEMM 分别取得最高 3.95×、4.78× 和 2.93× 的平均加速。},
  description = {第一作者工作。2026 年 9 月获 TACO 接收，10 月上线 Just Accepted 版本。统一优化 SpMV、SpMM 和 SpGEMM 的数据局部性与 GPU 执行效率。},
  keywords = {SpMV, SpMM, SpGEMM, Sparse Matrix, GPU, Cache Locality}
}

@inproceedings{cong2026dbspmspv,
  selected = {true},
  first_author = {true},
  status = {published},
  published_date = {2026-09},
  title = {DB-SpMSpV: Dual-View Blocked Sparse Matrix-Sparse Vector Multiplication for Dynamic GPU Workloads},
  author = {Cong, Xing and Xie, Chenhao and Wang, Rui and Luan, Zhongzhi and Liu, Yi and Qian, Depei},
  year = {2026},
  booktitle = {Proceedings of the 55th International Conference on Parallel Processing (ICPP)},
  pages = {617--627},
  month = {sep},
  publisher = {Association for Computing Machinery},
  doi = {10.1145/3832810.3832821},
  url = {https://doi.org/10.1145/3832810.3832821},
  abstract = {稀疏矩阵-稀疏向量乘法（SpMSpV）是图遍历、稀疏线性代数和稀疏模型推理中的核心计算原语。其输入向量通常呈动态稀疏特征，因此最优的 GPU 执行路径既取决于全局稀疏度，也取决于局部向量块的分布。现有 GPU SpMSpV 方法往往将存储布局、推/拉式遍历与计算核紧密绑定，若不引入额外存储或调度开销，便难以实现细粒度自适应。本文提出 DB-SpMSpV，一种面向动态 GPU 工作负载的双视图分块 SpMSpV 框架。DB-SpMSpV 将矩阵划分为固定大小的二维块，在高层维护块级 CSR/CSC 双视图，并复用单一底层块数据，同时支持行驱动的拉式计算与列驱动的推式计算。运行时，框架根据输入的块级稀疏度选择全局遍历路径，根据局部矩阵块与向量块结构选择块级微内核，并利用负载均衡、异步预取和分层写回，减少不规则内存访问、写回冲突与负载不均。我们进一步将该框架集成到 DB-BFS 和 DB-Decoding 中。我们在 NVIDIA A100 和 RTX 4090 上，使用 SuiteSparse 矩阵、对称图以及三个开源大语言模型评估 DB-SpMSpV。在不同输入稀疏度下，DB-SpMSpV 在 A100 上相较 cuSPARSE 获得平均 5.48×–64.34× 的加速，相较 TileSpMSpV 获得平均 2.36×–14.01× 的加速，并在 RTX 4090 上取得相近收益。DB-BFS 将端到端图遍历性能进一步提升：在 A100 上相较 TileBFS 平均加速 2.66×，在 RTX 4090 上平均加速 3.60×；DB-Decoding 则将单 token 线性层加速最高提升至 4.50×。},
  description = {第一作者工作。提出面向动态 GPU 工作负载的双视图分块 SpMSpV 框架 DB-SpMSpV，在复用单一底层块数据的同时，根据输入稀疏特征自适应选择全局推/拉式遍历与局部块级微内核，并将框架扩展至图遍历和稀疏大模型解码。},
  keywords = {SpMSpV, Sparse Matrix, GPU, Graph Traversal, LLM Inference}
}

@inproceedings{cong2026rtlynx,
  selected={true},
  first_author = {true},
  status = {published},
  published_date = {2026-07},
  title = {RT-Lynx: Putting GEMM Sparsity in the Right Place for Diffusion Models},
  author = {Cong, Xing and Tang, Hanlin and Liu, Kan and Lan, Tao and Qu, Lin and Xie, Chenhao},
  year = {2026},
  booktitle = {Proceedings of the 43rd International Conference on Machine Learning (ICML)},
  url = {https://proceedings.mlr.press/v306/cong26a.html},
  volume = {306},
  series = {Proceedings of Machine Learning Research},
  pages = {21293--21322},
  month = {jul},
  publisher = {PMLR},
  abstract = {RT-Lynx 是面向 diffusion transformer 的半结构化激活稀疏框架。该工作系统研究 DiT 推理中激活侧 2:4 N:M 稀疏相比权重侧稀疏更适合释放 Sparse Tensor Core 加速潜力的原因，并提出范数补偿、轻量级 LoRA 误差恢复等策略以保持生成质量。同时，RT-Lynx 构建在线融合稀疏推理流水线，将激活筛选、格式压缩与稀疏 GEMM 融合到 CUDA 执行路径中，降低动态稀疏开销。},
  description = {第一作者工作。面向 DiT 设计半结构化激活稀疏框架 RT-Lynx，系统验证激活侧相比权重侧更适合 2:4 N:M 稀疏，并结合范数补偿、轻量级 LoRA 误差恢复与在线融合稀疏推理流水线释放 Sparse Tensor Core 加速潜力。},
  keywords = {Diffusion Models, Sparse GEMM, GPU Acceleration, AI Infrastructure}
}

@inproceedings{cong2025cbspmv,
  selected={true},
  first_author = {true},
  status = {published},
  published_date = {2025-06},
  title = {CB-SpMV: A Data Aggregating and Balance Algorithm for Cache-Friendly Block-Based SpMV on GPUs},
  author = {Cong, Xing and Sun, FuKai and Chen, YiFan and Xie, Chenhao and Liu, Yi and Qian, Depei},
  year = {2025},
  booktitle = {Proceedings of the 39th ACM International Conference on Supercomputing (ICS)},
  url = {https://doi.org/10.1145/3721145.3725746},
  pages = {149--160},
  month = {jun},
  publisher = {Association for Computing Machinery},
  doi = {10.1145/3721145.3725746},
  abstract = {CB-SpMV 是面向 GPU SpMV 的缓存友好块稀疏框架。该工作针对访存跳跃、线程空转与负载不均问题，通过块内数据聚合、虚拟指针、列聚合与自适应子块格式选择统一优化数据局部性和硬件利用率。在数千个矩阵上的大规模评测表明，CB-SpMV 在 NVIDIA A100 与 RTX 4090 上优于 cuSPARSE、TileSpMV 和 DASP，并显著提升缓存局部性。},
  description = {第一作者工作。针对 GPU SpMV 中访存跳跃、线程空转与负载不均问题，提出缓存友好的块稀疏框架 CB-SpMV，通过块内数据聚合、虚拟指针、列聚合与自适应子块格式选择统一优化数据局部性和硬件利用率。},
  keywords = {SpMV, Sparse Matrix, GPU, Cache Locality}
}

